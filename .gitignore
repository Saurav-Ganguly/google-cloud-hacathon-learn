# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Secrets
.env
*.env

# Obsidian editor state
.obsidian/workspace.json
.obsidian/workspace-mobile.json

# Firecrawl cache
.firecrawl/

# Large media files (not needed in repo)
resources/**/*.mp4
resources/**/*.webm
resources/**/*.mkv
resources/**/*.avi
resources/**/*.mov
resources/**/*.wmv
resources/**/*.flv
resources/**/*.m4v

# ADK runtime artifacts (per-session DBs + saved Parts)
test/.adk/
test/**/.adk/

# Sandbox input PDFs (treated as local-only test fixtures)
test/**/*.pdf

# Sandbox-generated outputs
test/**/output.html
